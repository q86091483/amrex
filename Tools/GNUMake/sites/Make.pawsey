#
# For PAWSEY machines: setonix
#

ifneq ($(which_computer),$(filter $(which_computer),setonix))
  $(error Unknown PAWSEY computer, $(which_computer))
else
  $(info Loading compiler settings for Setonix@PAWSEY)
endif

